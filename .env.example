# Copy to .env.local (git-ignored). Values for the monitoring Supabase project live in
# solviva-inquiry/.env (MONITORING_SUPABASE_URL / MONITORING_SUPABASE_ANON_KEY);
# `node scripts/sync-env.mjs` copies them here without printing them.

# Supabase (monitoring project). The anon key is public by design; RLS gates every read.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Monitoring API (FastAPI on Render). Leave as the dev proxy path in development.
VITE_MONITORING_API_URL=/api/monitoring

# n8n webhooks (ticket list / ticket + PMS intake). In development the Vite proxy maps /api/n8n to
# https://solviva.app.n8n.cloud/webhook. Append "/staging" to use the [STAGING] workflows, which read
# and write the odoo.sh STAGING build (see scripts/n8n/create-staging-workflows.mjs); without it the
# production workflows and production Odoo are used.
VITE_N8N_WEBHOOK_URL=/api/n8n/staging

# false = the Support forms validate and show success without posting to n8n/Odoo (safe for
# development against production). Set to true only when test submissions are welcome.
VITE_ENABLE_SUBMISSIONS=false
